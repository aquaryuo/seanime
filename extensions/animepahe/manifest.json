{
  "id": "aq-animepahe",
  "name": "AnimePahe",
  "version": "0.2.44",
  "manifestURI": "https://raw.githubusercontent.com/aquaryuo/seanime/main/extensions/animepahe/manifest.json",
  "language": "typescript",
  "type": "onlinestream-provider",
  "description": "Only animepahe compatibility layer you'll ever need",
  "author": "aquaryuo",
  "icon": "https://raw.githubusercontent.com/aquaryuo/seanime/main/extensions/animepahe/icon.png",
  "website": "https://animepahe.pw",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/aquaryuo/seanime/main/extensions/animepahe/provider.ts",
  "userConfig": {
    "version": 1,
    "requiresConfig": false,
    "fields": [
      {
        "type": "select",
        "name": "baseUrl",
        "label": "Site domain — the old domains below redirect to animepahe.pw",
        "default": "https://animepahe.pw",
        "options": [
          {
            "value": "https://animepahe.pw",
            "label": "animepahe.pw (current)"
          },
          {
            "value": "https://animepahe.com",
            "label": "animepahe.com (redirects to .pw)"
          },
          {
            "value": "https://animepahe.org",
            "label": "animepahe.org (redirects to .pw)"
          }
        ]
      },
      {
        "type": "text",
        "name": "solverUrl",
        "label": "[!] Solver endpoint — run it via Aqua's Utils",
        "default": "http://127.0.0.1:8191/v1"
      },
      {
        "type": "text",
        "name": "solverSession",
        "label": "Solver session — must match Aqua's Utils (default: seanime)",
        "default": "seanime"
      }
    ]
  }
}
